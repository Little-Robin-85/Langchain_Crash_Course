# ==============================================================================
# Google Gemini & LangChain Environment Configuration
# ==============================================================================

# Google Gemini API Key (obtain from Google AI Studio: https://aistudio.google.com/)
# Note: langchain-google-genai checks GOOGLE_API_KEY and GEMINI_API_KEY.
GEMINI_API_KEY="your_gemini_api_key_here"
GOOGLE_API_KEY="your_gemini_api_key_here"

# Primary chat models
# Recommended latest standards:
# - "gemini-3.5-flash-lite" : Super fast, highly cost-efficient, great for tools and simple turns
# - "gemini-3.6-flash"      : Advanced multimodal reasoning, structured output, and complex logic
GEMINI_MODEL="gemini-3.5-flash-lite"
ADVANCED_MODEL="gemini-3.6-flash"

# Embedding Model for Semantic Search / Vector Stores (RAG)
# - "gemini-embedding-001" : 3,072 dimensional dense vectors
Embedding="gemini-embedding-001"
EMBEDDING_MODEL="gemini-embedding-001"

# LangSmith Observability & Tracing (optional, but enabled if keys are provided)
# Allows inspecting full agent traces, tool inputs/outputs, and latency in LangSmith
LANGCHAIN_API_KEY="your_langsmith_api_key_here"
LANGSMITH_API_KEY="your_langsmith_api_key_here"
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_ENDPOINT="https://eu.api.smith.langchain.com"
LANGCHAIN_PROJECT="LangChain-Gemini-Crash-Course"

# Search tool API key (optional, used if integrating external search tools)
SERPAPI_API_KEY="your_serpapi_key_here"
